{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
    "exclude": [
    "node_modules",
    // Scripts autonomes lancés par `node --experimental-strip-types` : ils
    // importent avec l'extension .ts, ce que le bundler Next refuse.
    "scripts",
    // Même raison pour les tests, et une bonne nouvelle en passant : ils ne
    // tournaient plus du tout. Node 22.22 ne résout plus « ./relances » vers
    // « relances.ts » — chaque fichier de test échouait sur
    // ERR_MODULE_NOT_FOUND avant d'exécuter le moindre cas. Les imports
    // portent maintenant l'extension, et `npm run test` les relance tous.
    "**/*.test.mts"
  ]
}
