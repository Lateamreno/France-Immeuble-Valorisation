# --- Source de données du BO ---
# Mode Supabase (recommandé) : lectures/écritures sur les tables miroir bo_*
# du projet DÉDIÉ france-immeuble-bo (sojtmhdrzmdbtqborxsi). Clé service_role :
# Dashboard Supabase → Project Settings → API keys. NE JAMAIS l'exposer côté client (pas de NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://sojtmhdrzmdbtqborxsi.supabase.co

# Repli Bubble (lecture Data API) + proxy photos privées (/api/photo).
BUBBLE_APP_URL=https://vente.france-immeuble.fr
BUBBLE_API_TOKEN=
BUBBLE_ENV=live

# Marketplace Plein Bail (client navigateur, RLS publique).
NEXT_PUBLIC_SUPABASE_URL=https://fkfwucqpdhbkgkouccyi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- E-mail : deux routes, jamais une seule (voir CLAUDE.md §7.1) ---

# Route NOMINATIVE (le un-à-un : estimation au propriétaire, devis, réponse).
# Part de la boîte de l'agent. Aucune de ces valeurs ne doit être préfixée
# NEXT_PUBLIC_ : ce préfixe expédierait le mot de passe dans le HTML de la page.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Route de MASSE (les salves). Relais SendGrid : l'identifiant vaut
# littéralement « apikey », le mot de passe est la clé d'API.
MASSE_SMTP_HOST=smtp.sendgrid.net
MASSE_SMTP_PORT=587
MASSE_SMTP_USER=apikey
MASSE_SMTP_PASS=

# Le sous-domaine d'envoi, authentifié chez SendGrid (Domain Authentication).
# Posé, chaque salve part sous l'adresse de son agent : r.voci@agence…
# Il DOIT être un sous-domaine dédié, jamais le domaine de tous les jours —
# une campagne qui tourne mal n'entame alors rien de la messagerie courante.
MASSE_DOMAINE=agence.france-immeuble.fr
# Repli si MASSE_DOMAINE est absente : une adresse de service unique.
MASSE_FROM=

# Plafond quotidien tous envois de masse confondus. Au-delà de 5 000 par jour,
# Gmail classe l'expéditeur en « masse » et lui impose ses obligations : on
# s'arrête avant, avec une marge.
PLAFOND_JOUR=4000

# Filet de recette : si elle est posée, TOUT part vers cette adresse au lieu du
# vrai destinataire. Indispensable pour essayer sans écrire à un client.
MAIL_REDIRECT=
